# Required
TURBOPUFFER_API_KEY=
TURBOPUFFER_REGION=aws-us-east-1

# Supabase. The Marketplace integration adds POSTGRES_URL, POSTGRES_URL_NON_POOLING and the SUPABASE_* variables;
# `npm run setup-db` uses those to create the tables and prints APP_DATABASE_URL (the app's own, limited role).
APP_DATABASE_URL=
# POSTGRES_URL=
# POSTGRES_URL_NON_POOLING=
# Optional: the app and setup-db require SSL; set off only for a local Postgres without it
# PGSSL=off

# Clerk sign-in. Added by the Vercel Marketplace integration; `vercel env pull` brings them down locally.
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=

# Copilot. On Vercel it runs through AI Gateway with the project's OIDC token; locally, run
# `vercel link` and `vercel env pull` (token lasts 12 hours) or set an AI Gateway key.
# AI_GATEWAY_API_KEY=
# COPILOT_MODEL=anthropic/claude-sonnet-5.5
# Optional: setting this calls Anthropic directly instead of AI Gateway (model id then claude-sonnet-5-5)
# ANTHROPIC_API_KEY=

# Optional: Langfuse tracing of copilot and eligibility calls (US cloud shown)
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_BASE_URL=https://us.cloud.langfuse.com

# Notes sync: shared secret for /api/index-notes, the once-a-minute sweep Supabase's pg_cron calls.
# Any long random string; the same value on Vercel, here, and in Supabase Vault (npm run setup-index-cron).
INDEX_NOTES_SECRET=

# Optional: block every edit (notes and patient records)
# READ_ONLY=true

# Optional: in production, accept Clerk session tokens only from these origins (comma-separated)
# CLERK_AUTHORIZED_ORIGINS=https://match.trialscope.space
